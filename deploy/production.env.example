APP_ENV=production
APP_DEBUG=false
APP_URL=https://cleanmanage.example.com
DB_HOST=127.0.0.1
DB_NAME=cleanmanage_db
DB_USER=cleanmanage_app
DB_PASS=replace_with_a_unique_database_password
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=no-reply@cleanmanage.local
SMTP_FROM_NAME=CleanManage
WHATSAPP_API_TOKEN=
WHATSAPP_FROM_NUMBER=
JWT_SECRET=replace_with_a_strong_random_secret
SESSION_SECURE=true
SESSION_SAME_SITE=Lax
